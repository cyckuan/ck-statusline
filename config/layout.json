{
  "mode": "verbose",
  "order": [
    "badge",
    "context",
    "model",
    "agents",
    "cost",
    "elapsed",
    "tools",
    "tokens",
    "cpu",
    "memory",
    "cwd",
    "branch",
    "remote",
    "behind"
  ],
  "compact": {
    "exclude": [
      "tokens",
      "remote"
    ]
  },
  "notifications": {
    "cost_warn": 5,
    "cost_critical": 20,
    "context_warn": 70,
    "context_critical": 90,
    "memory_warn": 80,
    "memory_critical": 95
  }
}
